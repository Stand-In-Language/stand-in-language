-- helper functions section --
id = \x -> x

d2c = \n f b -> { id
                , \recur i  -> f (recur (left i))
                , \i -> b
                } n

-- refinement section --
Bool = \vv -> if vv
              then if (left vv)
                   then 0
                   else if (right vv) then 0 else 1
              else 1

NonZero = \x -> case x of
	0 -> 0
	_ -> 1

One = \x -> case x of
  1 -> 1
  _ -> 0

Num = \l -> let test = \recur tv -> if (right tv)
				                            then 0
                                    else recur (left tv)
                base = \b -> if b then 0 else 1
            in d2c l test base

List = \t x -> foldr (\a b -> and (t a) b) 1 x

-- recursion is driven by s alone, so x may be unbounded input
Vector = \s t x ->
  let step = \acc -> let rest = right acc
                         ok = and (left acc) (and (toBool rest) (t (left rest)))
                     in (ok, right rest)
      final = d2c s step (1, x)
  in and (left final) (not (toBool (right final)))

-- normal prelude functions --
toBool = \b -> if b then 1 else 0

ite = \(i : Bool) t e -> if i then t else e

and = \(a : Bool) (b : Bool) -> if a then b else 0

or = \(a : Bool) (b : Bool) -> if a then 1 else b

not = \(x : Bool) -> if x then 0 else 1

succByte = \x -> let nextX : Num 255 = (x,0) in nextX

c2Byte = \c -> c succByte 0

plusByte = \x -> d2c x succByte

plus = \m n f x -> m f (n f x)

times = \m n f -> m (n f)

timesByte = \a b -> d2c b (plusByte a) 0

pow = \m n -> n m

powByte = \a b -> d2c b (timesByte a) 1

minus = \a b -> d2c (b (\x -> left x) (a succByte 0))

numDec = \(x : NonZero) -> left x

minusByte = \a b -> d2c b numDec a

-- comparisons recurse on b alone, so a may be unbounded input
gt = \a b -> toBool (d2c b left a)

leq = \a b -> not (gt a b)

range = \a b -> { minusByte b
		, \recur i -> (i, recur (succByte i))
		, \i -> 0
		} a

map = \f -> { id
            , \recur l -> (f (left l), recur (right l))
            , \l -> 0
            }

foldr = \f b ta -> let fixed = { id
                               , \recur l accum -> f (left l) (recur (right l) accum)
                               , \l accum -> accum
                               }
                   in fixed ta b

foldl = \f b ta -> let fixed = { id
                               , \recur l accum -> recur (right l) (f accum (left l))
                               , \l accum -> accum
                               }
                   in fixed ta b

zipWith = \f a b -> let fixed = { \ab -> and (toBool (left ab)) (toBool (right ab))
                                , \recur ab -> (f (left (left ab)) (left (right ab))
                                               , recur (right (left ab), right (right ab))
                                               )
                                , \ab -> 0
                                }
                    in fixed (a,b)

filter = \f -> foldr (\a b -> if f a then (a, b) else b) 0

dEqual = \a b -> let equalsOne = \x -> if x then (not (toBool (left x))) else 0
                 in if a then equalsOne (d2c (left a) (\x -> left x) b)
                         else not (toBool b)

dDiv = \a (b : NonZero) ->
	let dSub = \a b -> d2c b left a
	in { \p -> dSub (left p) (right p)
	   , \recur p -> succByte (recur (dSub (left p) (right p), right p))
	   , \p -> if (dEqual (left p) (right p)) then 1 else 0
	   } (a, b)

listLength = foldr (\a b -> succByte b) 0

-- recursion is driven by the first list alone, so the second may be unbounded
-- input (case patterns put the literal first)
listEqual = \a b -> let walk = { \p -> left p
                               , \recur p -> and (and (toBool (right p))
                                                      (dEqual (left (left p)) (left (right p))))
                                                 (recur (right (left p), right (right p)))
                               , \p -> not (toBool (right p))
                               }
                    in walk (a, b)

listPlus = \a b -> foldr (\x l -> (x,l)) b a

flip = \f a b -> f b a

-- functional concatenation
con  = \f g x -> g (f x)

concat = foldr listPlus 0

drop = \n l -> n (\x -> right x) l

take = \n l -> let lengthed = n (\x -> (0,x)) 0
               in zipWith (\a b -> a) l lengthed

factorial = \n -> foldr (\a b -> times (d2c a) b) $1 (range 1 (n,0))

dFactorial = \n -> c2Byte (factorial n)

quicksort =
     { \l -> right l
     , \recur l -> let t = left l
                       test = \x -> gt x t
                       p1 = filter test (right l)
                       p2 = filter (\x -> not (test x)) (right l)
                   in listPlus (recur p2) (t,(recur p1))
     , id
     }

-- useful for making sure main input isn't unbounded
truncate = \n ->
  let layer = \recur current -> if current
                                then (recur (left current), recur (right current))
                                else 0
  in n layer (\x -> 0)

min = \a b -> { \p -> and (toBool (left p)) (toBool (right p))
              , \recur p -> recur (left (left p), left (right p))
              , \p -> if (left p) then b else a
              } (a,b)

max = \a b -> { \p -> and (toBool (left p)) (toBool (right p))
              , \recur p -> recur (left (left p), left (right p))
              , \p -> if (left p) then a else b
              } (a,b)

fakeRecur = \n t r b -> n (\rec i -> if t i then r rec i else b i) b

modByte = \a b -> minusByte a (timesByte b (dDiv a b))

gcd = \a b ->
  { \p -> not (dEqual (right p) 0)
  , \recur p -> recur (right p, modByte (left p) (right p))
  , \p -> left p
  } (a,b)

lcm = \a b -> dDiv (timesByte a b) (gcd a b)
